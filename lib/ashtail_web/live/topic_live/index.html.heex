<Layouts.app flash={@flash} section={:topics}>
  <.header>
    Topics
    <:subtitle>{@total} topics</:subtitle>
  </.header>

  <.broker_error error={@broker_error} />

  <div class="flex flex-col sm:flex-row sm:items-end gap-4 mb-6">
    <form id="search-form" data-search-form phx-change="search" class="w-full sm:w-auto">
      <label for="q" class="sr-only">Search</label>
      <label class="input input-sm w-full sm:w-80 rounded-full bg-base-100">
        <.icon name="hero-magnifying-glass" class="size-4 opacity-60" />
        <input
          type="text"
          id="q"
          name="q"
          value={@search}
          phx-debounce="200"
          placeholder="Filter by name"
        />
        <span class="loading loading-spinner loading-xs hidden phx-change-loading:inline-block" />
      </label>
    </form>

    <form
      id="page-size-form"
      data-page-size-form
      phx-change="page_size"
      class="flex items-center gap-2 sm:ml-auto"
    >
      <label for="page_size" class="text-xs text-base-content/60">Per page</label>
      <select id="page_size" name="page_size" class="select select-sm w-20">
        <option value="20" selected={@page_size == 20}>20</option>
        <option value="50" selected={@page_size == 50}>50</option>
      </select>
      <span class="loading loading-spinner loading-xs hidden phx-change-loading:inline-block" />
    </form>
  </div>

  <.table
    id="topics"
    rows={@streams.topics}
    empty="No topics match."
    row_attrs={fn topic -> %{"data-topic" => topic.name} end}
  >
    <:col :let={topic} label="Name">
      <.link
        navigate={~p"/topics/#{topic.name}"}
        class="link link-hover font-mono break-all line-clamp-3 sm:line-clamp-2"
      >
        {topic.name}
      </.link>
    </:col>
    <:col :let={topic} label="Partitions" numeric class="sm:w-32">
      <span class="sm:hidden text-base-content/60">Partitions</span>
      <span data-partitions>{topic.partition_count}</span>
    </:col>
    <:col :let={topic} label="Replication" numeric class="sm:w-28">
      <span class="sm:hidden text-base-content/60">RF</span>
      <span data-replication>{topic.replication_factor}</span>
    </:col>
    <:col :let={topic} label="Messages" numeric class="sm:w-36">
      <span class="sm:hidden text-base-content/60">Messages</span>
      <span data-messages class={topic.message_count == 0 && "text-base-content/40"}>
        {topic.message_count}
      </span>
    </:col>
    <:footer>
      <div class="flex items-center justify-between gap-4">
        <span class="text-sm text-base-content/60">Page {@page} of {@page_count}</span>
        <.pager
          prev_patch={if @page > 1, do: page_path(@page - 1, @page_size, @search)}
          next_patch={if @page < @page_count, do: page_path(@page + 1, @page_size, @search)}
        />
      </div>
    </:footer>
  </.table>
</Layouts.app>
