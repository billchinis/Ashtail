<Layouts.app flash={@flash} section={:groups}>
  <.header>
    Consumer groups
    <:subtitle>{@total} groups</:subtitle>
  </.header>

  <.broker_error error={@broker_error} />

  <div class="flex flex-col sm:flex-row sm:items-end gap-4 mb-6">
    <form
      id="sort-form"
      data-sort-form
      phx-change="sort_select"
      class="flex items-center gap-2 sm:hidden"
    >
      <label for="sort" class="text-xs text-base-content/60">Sort by</label>
      <select id="sort" name="sort" class="select select-sm flex-1">
        <option
          :for={{value, label} <- @sort_options}
          value={value}
          selected={value == "#{@sort}:#{@dir}"}
        >
          {label}
        </option>
      </select>
    </form>

    <form
      id="page-size-form"
      data-page-size-form
      phx-change="page_size"
      class="flex items-center gap-2 sm:ml-auto"
    >
      <label for="page_size" class="text-xs text-base-content/60">Per page</label>
      <select id="page_size" name="page_size" class="select select-sm w-20">
        <option value="20" selected={@page_size == 20}>20</option>
        <option value="50" selected={@page_size == 50}>50</option>
      </select>
      <span class="loading loading-spinner loading-xs hidden phx-change-loading:inline-block" />
    </form>
  </div>

  <.table
    id="groups"
    rows={@streams.groups}
    empty="No consumer groups on this cluster."
    sort_link={&sort_path(@query, &1)}
    sort_by={@sort}
    sort_dir={@dir}
    row_attrs={
      fn group ->
        %{
          "data-group" => group.id,
          "data-group-state" => group.state,
          "data-total-lag" => group.total_lag,
          class: state_class(group.state)
        }
      end
    }
  >
    <:col :let={group} label="Group" sort={:id}>
      <.link navigate={~p"/groups/#{group.id}"} class="link link-hover font-mono break-all">
        {group.id}
      </.link>
    </:col>
    <:col :let={group} label="State" sort={:state} class="sm:w-48">
      <.state_pill state={group.state} />
    </:col>
    <:col :let={group} label="Members" numeric sort={:members} class="sm:w-24">
      <span class="text-base-content/60 sm:hidden">Members </span>{group.member_count}
    </:col>
    <:col :let={group} label="Total lag" numeric sort={:lag} class="sm:w-36">
      <span class="text-base-content/60 sm:hidden">Lag </span>
      <.lag lag={group.total_lag} class="text-2xl leading-none" />
    </:col>
    <:col :let={group} label="Partitions" class="max-sm:basis-full">
      <button
        :if={not group.expanded?}
        type="button"
        data-expand-group
        class="btn btn-xs btn-ghost phx-click-loading:opacity-60 max-sm:btn-block"
        phx-click="expand_group"
        phx-value-group={group.id}
      >
        <.icon name="hero-chevron-down" class="size-3" /> Expand
      </button>
      <button
        :if={group.expanded?}
        type="button"
        data-collapse-group
        class="btn btn-xs btn-ghost phx-click-loading:opacity-60 max-sm:btn-block"
        phx-click="collapse_group"
        phx-value-group={group.id}
      >
        <.icon name="hero-chevron-up" class="size-3" /> Collapse
      </button>
      <div :if={group.expanded?} class="bg-base-200 rounded-xl p-3 mt-2 overflow-x-auto">
        <table data-group-partitions class="table table-sm w-full">
          <thead>
            <tr>
              <th class="text-xs font-medium uppercase tracking-wide text-base-content/50">
                Topic
              </th>
              <th class="text-right tabular-nums whitespace-nowrap text-xs font-medium uppercase tracking-wide text-base-content/50">
                Partition
              </th>
              <th class="text-right tabular-nums whitespace-nowrap text-xs font-medium uppercase tracking-wide text-base-content/50">
                Committed
              </th>
              <th class="text-right tabular-nums whitespace-nowrap text-xs font-medium uppercase tracking-wide text-base-content/50">
                Latest
              </th>
              <th class="text-right tabular-nums whitespace-nowrap text-xs font-medium uppercase tracking-wide text-base-content/50">
                Lag
              </th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={p <- group.partitions}
              data-topic={p.topic}
              data-partition={p.partition}
              data-lag={p.lag}
            >
              <td class="py-2 px-3 font-mono break-all">{p.topic}</td>
              <td class="py-2 px-3 text-right tabular-nums whitespace-nowrap">{p.partition}</td>
              <td class="py-2 px-3 text-right tabular-nums whitespace-nowrap">
                {p.committed_offset}
              </td>
              <td class="py-2 px-3 text-right tabular-nums whitespace-nowrap">
                {p.latest_offset}
              </td>
              <td class="py-2 px-3 text-right tabular-nums whitespace-nowrap">
                <.lag lag={p.lag} size={:small} />
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </:col>
    <:footer>
      <div class="flex items-center justify-between gap-4">
        <span class="text-sm text-base-content/60">Page {@page} of {@page_count}</span>
        <.pager
          prev_patch={if @page > 1, do: list_path(@query, page: @page - 1)}
          next_patch={if @page < @page_count, do: list_path(@query, page: @page + 1)}
        />
      </div>
    </:footer>
  </.table>
</Layouts.app>
