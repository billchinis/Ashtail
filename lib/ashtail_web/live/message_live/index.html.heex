<Layouts.app flash={@flash} section={:topics}>
  <div class="space-y-6">
    <div>
      <.link
        navigate={~p"/topics/#{@topic_name}/partitions"}
        class="link link-hover text-sm text-base-content/60"
      >
        ← {@topic_name}
      </.link>
      <h1 class="mt-1 font-serif text-2xl sm:text-3xl font-semibold tracking-tight break-all">
        Topic {@topic_name}, partition {@partition}
      </h1>
    </div>

    <.broker_error error={@broker_error} />

    <div class="flex flex-wrap items-center justify-between gap-4">
      <.page_size_select page_size={@page_size} />
      <.tail_control tailing?={@tailing?} />
    </div>

    <% prev_patch =
      if @earliest != nil and @offset > @earliest,
        do:
          message_path(
            @topic_name,
            @partition,
            max(@earliest, @offset - @page_size),
            @page_size
          )

    next_patch =
      if @latest != nil and @offset + @page_size < @latest,
        do: message_path(@topic_name, @partition, @offset + @page_size, @page_size) %>
    <.message_list
      :let={message}
      id="messages"
      rows={@streams.messages}
      row_attrs={
        fn message ->
          %{"data-offset" => message.offset, "data-timestamp" => iso_timestamp(message.timestamp)}
        end
      }
    >
      <:empty>No messages at this offset.</:empty>
      <.message_row message={message} />
      <:footer :if={prev_patch || next_patch}>
        <.pager prev_patch={prev_patch} next_patch={next_patch} />
      </:footer>
    </.message_list>
  </div>
</Layouts.app>
