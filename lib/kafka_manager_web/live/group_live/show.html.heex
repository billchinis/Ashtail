<Layouts.app flash={@flash} section={:groups}>
  <div class="space-y-6">
    <div>
      <.link navigate={~p"/groups"} class="link link-hover text-sm text-base-content/60">
        ← Consumer groups
      </.link>
      <h1 class="mt-1 font-serif text-2xl sm:text-3xl font-semibold tracking-tight break-all">
        Consumer group {@group_id}
      </h1>
    </div>

    <.broker_error error={@broker_error} />

    <div
      :if={@group}
      class="stats stats-vertical sm:stats-horizontal bg-base-100 shadow-sm w-full sm:w-fit"
    >
      <div class="stat">
        <div class="stat-title text-xs">State</div>
        <div class="stat-value">
          <.state_pill state={@group.state} size="badge-md" />
        </div>
      </div>
      <div class="stat">
        <div class="stat-title text-xs">Members</div>
        <div class="stat-value text-2xl tabular-nums">{@group.member_count}</div>
      </div>
      <div class="stat">
        <div class="stat-title text-xs">Total lag</div>
        <div class="stat-value">
          <.lag lag={@group.total_lag} class="text-3xl" />
        </div>
      </div>
    </div>

    <.table
      id="group_partitions"
      rows={@streams.group_partitions}
      empty="This group has no committed offsets."
      row_attrs={
        fn p ->
          %{
            "data-topic" => p.topic,
            "data-partition" => p.partition,
            "data-committed-offset" => p.committed_offset,
            "data-lag" => p.lag
          }
        end
      }
    >
      <:col :let={p} label="Topic">
        <span class="font-mono break-all">{p.topic}</span>
      </:col>
      <:col :let={p} label="Partition" numeric>
        <span class="text-base-content/60 sm:hidden">Partition </span>{p.partition}
      </:col>
      <:col :let={p} label="Committed offset" numeric>
        <span class="text-base-content/60 sm:hidden">Committed </span>{p.committed_offset}
      </:col>
      <:col :let={p} label="Latest offset" numeric>
        <span class="text-base-content/60 sm:hidden">Latest </span>{p.latest_offset}
      </:col>
      <:col :let={p} label="Lag" numeric>
        <span class="text-base-content/60 sm:hidden">Lag </span>
        <.lag lag={p.lag} class="text-xl leading-none" />
      </:col>
    </.table>
  </div>
</Layouts.app>
