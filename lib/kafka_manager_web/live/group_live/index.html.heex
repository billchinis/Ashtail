<Layouts.app flash={@flash} section={:groups}>
  <.header>Consumer groups</.header>

  <.broker_error error={@broker_error} />

  <.table
    id="groups"
    rows={@streams.groups}
    empty="No consumer groups on this cluster."
    row_attrs={
      fn group ->
        %{
          "data-group" => group.id,
          "data-group-state" => group.state,
          "data-total-lag" => group.total_lag,
          class: state_class(group.state)
        }
      end
    }
  >
    <:col :let={group} label="Group">
      <.link navigate={~p"/groups/#{group.id}"} class="link link-hover font-mono break-all">
        {group.id}
      </.link>
    </:col>
    <:col :let={group} label="State" class="sm:w-48">
      <.state_pill state={group.state} />
    </:col>
    <:col :let={group} label="Members" numeric class="sm:w-24">
      <span class="text-base-content/60 sm:hidden">Members </span>{group.member_count}
    </:col>
    <:col :let={group} label="Total lag" numeric class="sm:w-36">
      <span class="text-base-content/60 sm:hidden">Lag </span>
      <.lag lag={group.total_lag} class="text-2xl leading-none" />
    </:col>
    <:col :let={group} label="Partitions" class="max-sm:basis-full">
      <button
        :if={not group.expanded?}
        type="button"
        data-expand-group
        class="btn btn-xs btn-ghost phx-click-loading:opacity-60 max-sm:btn-block"
        phx-click="expand_group"
        phx-value-group={group.id}
      >
        <.icon name="hero-chevron-down" class="size-3" /> Expand
      </button>
      <button
        :if={group.expanded?}
        type="button"
        data-collapse-group
        class="btn btn-xs btn-ghost phx-click-loading:opacity-60 max-sm:btn-block"
        phx-click="collapse_group"
        phx-value-group={group.id}
      >
        <.icon name="hero-chevron-up" class="size-3" /> Collapse
      </button>
      <div :if={group.expanded?} class="bg-base-200 rounded-xl p-3 mt-2 overflow-x-auto">
        <table data-group-partitions class="table table-sm w-full">
          <thead>
            <tr>
              <th class="text-xs font-medium uppercase tracking-wide text-base-content/50">
                Topic
              </th>
              <th class="text-right tabular-nums whitespace-nowrap text-xs font-medium uppercase tracking-wide text-base-content/50">
                Partition
              </th>
              <th class="text-right tabular-nums whitespace-nowrap text-xs font-medium uppercase tracking-wide text-base-content/50">
                Committed
              </th>
              <th class="text-right tabular-nums whitespace-nowrap text-xs font-medium uppercase tracking-wide text-base-content/50">
                Latest
              </th>
              <th class="text-right tabular-nums whitespace-nowrap text-xs font-medium uppercase tracking-wide text-base-content/50">
                Lag
              </th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={p <- group.partitions}
              data-topic={p.topic}
              data-partition={p.partition}
              data-lag={p.lag}
            >
              <td class="py-2 px-3 font-mono break-all">{p.topic}</td>
              <td class="py-2 px-3 text-right tabular-nums whitespace-nowrap">{p.partition}</td>
              <td class="py-2 px-3 text-right tabular-nums whitespace-nowrap">
                {p.committed_offset}
              </td>
              <td class="py-2 px-3 text-right tabular-nums whitespace-nowrap">
                {p.latest_offset}
              </td>
              <td class="py-2 px-3 text-right tabular-nums whitespace-nowrap">
                <.lag lag={p.lag} size={:small} />
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </:col>
  </.table>
</Layouts.app>
