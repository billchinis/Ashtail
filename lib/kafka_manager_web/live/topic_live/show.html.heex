<Layouts.app flash={@flash} section={:topics}>
  <.topic_header
    topic_name={@topic_name}
    topic={@topic}
    active={:data}
    broker_error={@broker_error}
  />

  <div class="grid xl:grid-cols-5 gap-6 mt-6">
    <section class="xl:col-span-3">
      <h2 class="text-xs font-medium uppercase tracking-wide text-base-content/50 mb-2">
        Partitions
      </h2>
      <.table
        id="partitions"
        rows={@streams.partitions}
        empty="No partitions returned."
        row_attrs={
          fn p ->
            %{"data-partition" => p.id, "data-earliest" => p.earliest, "data-latest" => p.latest}
          end
        }
      >
        <:col :let={p} label="Partition">
          <.link
            navigate={~p"/topics/#{@topic_name}/partitions/#{p.id}"}
            class="link link-hover font-mono inline-flex items-center gap-1"
          >
            {p.id} <.icon name="hero-chevron-right" class="size-3" />
          </.link>
        </:col>
        <:col :let={p} label="Leader">{p.leader}</:col>
        <:col :let={p} label="Replicas">{Enum.join(p.replicas, ",")}</:col>
        <:col :let={p} label="Earliest" numeric>{p.earliest}</:col>
        <:col :let={p} label="Latest" numeric>{p.latest}</:col>
      </.table>
    </section>

    <section class="xl:col-span-2">
      <h2 class="text-xs font-medium uppercase tracking-wide text-base-content/50 mb-2">
        Configuration
      </h2>
      <.table
        id="topic_configs"
        rows={@streams.topic_configs}
        empty="No configuration returned."
        row_attrs={fn entry -> %{"data-config-name" => entry.name} end}
      >
        <:col :let={entry} label="Name" class="w-1/2">
          <span class="font-mono text-sm break-all">{entry.name}</span>
        </:col>
        <:col :let={entry} label="Value">
          <span class="font-mono text-sm break-all">{entry.value}</span>
        </:col>
      </.table>
    </section>
  </div>
</Layouts.app>
