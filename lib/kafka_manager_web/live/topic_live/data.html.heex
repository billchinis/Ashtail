<Layouts.app flash={@flash} section={:topics}>
  <.topic_header
    topic_name={@topic_name}
    topic={@topic}
    active={:data}
    broker_error={@broker_error}
  />

  <div class="mt-6 space-y-4">
    <div class="card bg-base-100 shadow-sm">
      <form
        id="filter-form"
        phx-submit="apply"
        phx-change="filter_change"
        class={[
          "collapse sm:collapse-open",
          @filter_errors != %{} && "collapse-open"
        ]}
      >
        <input type="checkbox" class="peer sm:hidden p-0 min-h-0" aria-label="Toggle filters" />
        <div class="collapse-title sm:hidden min-h-12 h-12 py-0 flex items-center gap-2 px-5">
          <span>Filters</span>
          <span
            :if={applied_filter_count(@filter_params) > 0}
            class="badge badge-sm badge-primary"
          >{applied_filter_count(@filter_params)}</span>
          <.icon name="hero-chevron-down" class="size-4 ml-auto" />
        </div>
        <div class="collapse-content p-0!">
          <div class="card-body p-5 gap-4">
            <div class="grid grid-cols-1 sm:grid-cols-[minmax(0,3fr)_minmax(0,4fr)_minmax(0,3fr)] gap-4 sm:items-start">
              <fieldset class="fieldset">
                <div class="flex justify-between">
                  <legend class="text-xs font-medium">Key</legend>
                  <div class="join">
                    <input
                      type="radio"
                      name="filter[key_mode]"
                      value="text"
                      aria-label="Text"
                      class="join-item btn btn-xs"
                      checked={@filter_form[:key_mode].value in [nil, "", "text"]}
                    />
                    <input
                      type="radio"
                      name="filter[key_mode]"
                      value="regex"
                      aria-label="Regex"
                      class="join-item btn btn-xs"
                      checked={@filter_form[:key_mode].value == "regex"}
                    />
                  </div>
                </div>
                <input
                  type="text"
                  name="filter[key]"
                  value={@filter_form[:key].value}
                  class={[
                    "input input-sm w-full font-mono",
                    @filter_errors["key"] && "input-error"
                  ]}
                />
                <p
                  :if={@filter_errors["key"]}
                  data-filter-error="key"
                  class="text-xs text-error flex items-center gap-1"
                >
                  <.icon name="hero-exclamation-circle" class="size-3" />{@filter_errors["key"]}
                </p>
              </fieldset>

              <fieldset class="fieldset">
                <div class="flex justify-between">
                  <legend class="text-xs font-medium">Value</legend>
                  <div class="join">
                    <input
                      type="radio"
                      name="filter[value_mode]"
                      value="text"
                      aria-label="Text"
                      class="join-item btn btn-xs"
                      checked={@filter_form[:value_mode].value in [nil, "", "text"]}
                    />
                    <input
                      type="radio"
                      name="filter[value_mode]"
                      value="regex"
                      aria-label="Regex"
                      class="join-item btn btn-xs"
                      checked={@filter_form[:value_mode].value == "regex"}
                    />
                  </div>
                </div>
                <input
                  type="text"
                  name="filter[value]"
                  value={@filter_form[:value].value}
                  class={[
                    "input input-sm w-full font-mono",
                    @filter_errors["value"] && "input-error"
                  ]}
                />
                <p
                  :if={@filter_errors["value"]}
                  data-filter-error="value"
                  class="text-xs text-error flex items-center gap-1"
                >
                  <.icon name="hero-exclamation-circle" class="size-3" />{@filter_errors["value"]}
                </p>

                <div class="flex flex-col gap-3">
                  <div
                    :for={{row, position} <- Enum.with_index(@json_rows)}
                    :key={row.id}
                    id={"json-condition-#{row.id}"}
                    data-json-condition={row.id}
                    class="grid grid-cols-[6rem_minmax(0,1fr)_auto] sm:grid-cols-[minmax(0,3fr)_6rem_minmax(0,2fr)_auto] gap-1.5 items-center max-sm:[--size-field:0.25rem]"
                  >
                    <input
                      type="text"
                      name={"filter[json][#{row.id}][path]"}
                      value={row.path}
                      title={row.path}
                      placeholder="e.g. items[0].sku"
                      aria-label={"JSON path #{position + 1}"}
                      class={[
                        "input input-sm sm:input-xs w-full font-mono col-span-2 sm:col-span-1 order-1 sm:order-none",
                        @filter_errors["json-#{row.id}"] && "input-error"
                      ]}
                    />
                    <select
                      name={"filter[json][#{row.id}][op]"}
                      aria-label={"Operator #{position + 1}"}
                      class="select select-sm sm:select-xs w-24 order-3 sm:order-none"
                    >
                      <option value="equals" selected={row.op == "equals"}>equals</option>
                      <option value="contains" selected={row.op == "contains"}>contains</option>
                      <option value="regex" selected={row.op == "regex"}>regex</option>
                      <option value="exists" selected={row.op == "exists"}>exists</option>
                    </select>
                    <input
                      type="text"
                      name={"filter[json][#{row.id}][value]"}
                      value={row.value}
                      placeholder={if row.op == "exists", do: "no value", else: "value"}
                      readonly={row.op == "exists"}
                      aria-disabled={row.op == "exists" && "true"}
                      tabindex={row.op == "exists" && "-1"}
                      aria-label={"JSON value #{position + 1}"}
                      class={[
                        "input input-sm sm:input-xs w-full font-mono col-span-2 sm:col-span-1 order-4 sm:order-none",
                        @filter_errors["json-#{row.id}"] && "input-error",
                        row.op == "exists" &&
                          "bg-base-200 text-base-content/40 cursor-not-allowed"
                      ]}
                    />
                    <button
                      type="button"
                      phx-click="remove_json_condition"
                      phx-value-row={row.id}
                      data-remove-json-condition
                      aria-label={"Remove JSON field #{position + 1}"}
                      title={"Remove JSON field #{position + 1}"}
                      class="btn btn-sm sm:btn-xs btn-ghost btn-square text-base-content/50 order-2 sm:order-none"
                    >
                      <.icon name="hero-x-mark" class="size-3.5" />
                    </button>
                    <p
                      :if={@filter_errors["json-#{row.id}"]}
                      data-filter-error={"json-#{position}"}
                      class="col-span-full order-5 sm:order-none text-xs text-error flex items-start gap-1 break-words"
                    >
                      <.icon name="hero-exclamation-circle" class="size-3 mt-0.5 shrink-0" />
                      {@filter_errors["json-#{row.id}"]}
                    </p>
                  </div>
                </div>

                <button
                  type="button"
                  phx-click="add_json_condition"
                  data-add-json-condition
                  class="btn btn-sm sm:btn-xs btn-ghost text-base-content/70 justify-self-start"
                >
                  <.icon name="hero-plus" class="size-3" /> Add JSON field
                </button>
              </fieldset>

              <fieldset class="fieldset">
                <div class="flex justify-between">
                  <legend class="text-xs font-medium">Header</legend>
                  <div class="join">
                    <input
                      type="radio"
                      name="filter[header_mode]"
                      value="text"
                      aria-label="Text"
                      class="join-item btn btn-xs"
                      checked={@filter_form[:header_mode].value in [nil, "", "text"]}
                    />
                    <input
                      type="radio"
                      name="filter[header_mode]"
                      value="regex"
                      aria-label="Regex"
                      class="join-item btn btn-xs"
                      checked={@filter_form[:header_mode].value == "regex"}
                    />
                  </div>
                </div>
                <div class="join w-full">
                  <input
                    type="text"
                    name="filter[header]"
                    value={@filter_form[:header].value}
                    placeholder="name"
                    class={[
                      "input input-sm join-item font-mono w-2/5",
                      @filter_errors["header"] && "input-error"
                    ]}
                  />
                  <input
                    type="text"
                    name="filter[header_value]"
                    value={@filter_form[:header_value].value}
                    placeholder="value"
                    class={[
                      "input input-sm join-item font-mono w-3/5",
                      @filter_errors["header"] && "input-error"
                    ]}
                  />
                </div>
                <p
                  :if={@filter_errors["header"]}
                  data-filter-error="header"
                  class="text-xs text-error flex items-center gap-1"
                >
                  <.icon name="hero-exclamation-circle" class="size-3" />{@filter_errors["header"]}
                </p>
              </fieldset>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-end gap-4">
              <fieldset class="fieldset pb-0">
                <legend class="text-xs font-medium">Partition</legend>
                <select name="filter[partition]" class="select select-sm w-36">
                  <option value="" selected={@filter_form[:partition].value in [nil, ""]}>
                    All partitions
                  </option>
                  <option
                    :for={p <- partition_options(@topic)}
                    value={p}
                    selected={to_string(p) == @filter_form[:partition].value}
                  >
                    Partition {p}
                  </option>
                </select>
              </fieldset>

              <fieldset class="fieldset pb-0">
                <legend class="text-xs font-medium">From (UTC)</legend>
                <input
                  type="text"
                  name="filter[from]"
                  value={@filter_form[:from].value}
                  placeholder="YYYY-MM-DDTHH:MM:SS.sssZ"
                  class={[
                    "input input-sm w-56 font-mono text-xs",
                    @filter_errors["from"] && "input-error"
                  ]}
                />
                <p
                  :if={@filter_errors["from"]}
                  data-filter-error="from"
                  class="text-xs text-error flex items-center gap-1"
                >
                  <.icon name="hero-exclamation-circle" class="size-3" />{@filter_errors["from"]}
                </p>
              </fieldset>

              <fieldset class="fieldset pb-0">
                <legend class="text-xs font-medium">To (UTC)</legend>
                <input
                  type="text"
                  name="filter[to]"
                  value={@filter_form[:to].value}
                  placeholder="YYYY-MM-DDTHH:MM:SS.sssZ"
                  class={[
                    "input input-sm w-56 font-mono text-xs",
                    @filter_errors["to"] && "input-error"
                  ]}
                />
                <p
                  :if={@filter_errors["to"]}
                  data-filter-error="to"
                  class="text-xs text-error flex items-center gap-1"
                >
                  <.icon name="hero-exclamation-circle" class="size-3" />{@filter_errors["to"]}
                </p>
              </fieldset>

              <div class="flex gap-2 sm:ml-auto max-sm:flex-col">
                <button
                  type="button"
                  phx-click="clear"
                  class="btn btn-sm btn-ghost max-sm:btn-block"
                >
                  Clear
                </button>
                <button type="submit" class="btn btn-sm btn-neutral max-sm:btn-block">
                  <span class="phx-submit-loading:hidden">Apply</span>
                  <span class="hidden phx-submit-loading:inline-flex loading loading-spinner loading-xs" />
                </button>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>

    <div class="flex flex-wrap items-center gap-3 text-sm">
      <div
        data-scan-state={to_string(@scan_state)}
        data-scanned={@scanned}
        class="flex items-center gap-2"
      >
        <%= if @scan_state == :complete do %>
          <.icon name="hero-check-circle" class="size-4 text-success" />
          <span class="text-base-content/60">
            <%= if Filter.active?(@filter) do %>
              {@scanned} messages checked
            <% else %>
              {@scanned} messages loaded
            <% end %>
          </span>
        <% else %>
          <span class="loading loading-dots loading-sm text-primary" />
          <span class="font-medium">Searching… {@scanned} messages checked</span>
        <% end %>
      </div>

      <div class="flex items-center gap-3 max-sm:w-full sm:ml-auto">
        <.page_size_select page_size={@page_size} />
        <.tail_control tailing?={@tailing?} />
      </div>
    </div>

    <.message_list
      :let={message}
      id="messages"
      rows={@streams.messages}
      running={@scan_state == :running}
      row_attrs={
        fn message ->
          %{
            "data-partition" => message.partition,
            "data-offset" => message.offset,
            "data-timestamp" => iso_timestamp(message.timestamp)
          }
        end
      }
    >
      <:empty>
        <%= cond do %>
          <% @scan_state == :running -> %>
            <span class="loading loading-dots loading-sm text-primary" />
            Searching… no matches yet
          <% Filter.active?(@filter) -> %>
            <div class="space-y-2">
              <p>No messages match these filters.</p>
              <p class="text-xs">Checked {@scanned} messages.</p>
              <button type="button" phx-click="clear" class="btn btn-sm btn-ghost">
                Clear filters
              </button>
            </div>
          <% true -> %>
            This topic has no messages yet.
        <% end %>
      </:empty>
      <.message_row message={message} show_partition={true} />
      <:footer :if={@newer || @older}>
        <.pager
          prev_patch={@newer && DataParams.path(@topic_name, @filter_params, @page_size, @newer)}
          next_patch={@older && DataParams.path(@topic_name, @filter_params, @page_size, @older)}
          prev_label="Newer"
          next_label="Older"
        />
      </:footer>
    </.message_list>
  </div>
</Layouts.app>
