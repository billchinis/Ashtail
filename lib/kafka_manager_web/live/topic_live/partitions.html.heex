<Layouts.app flash={@flash} section={:topics}>
  <.topic_header
    topic_name={@topic_name}
    topic={@topic}
    active={:partitions}
    broker_error={@broker_error}
  />

  <div class="mt-6">
    <.table
      id="partitions"
      rows={@streams.partitions}
      empty="No partitions returned."
      row_attrs={
        fn p ->
          %{"data-partition" => p.id, "data-earliest" => p.earliest, "data-latest" => p.latest}
        end
      }
    >
      <:col :let={p} label="Partition">
        <.link
          navigate={~p"/topics/#{@topic_name}/partitions/#{p.id}"}
          class="link link-hover font-mono inline-flex items-center gap-1"
        >
          {p.id} <.icon name="hero-chevron-right" class="size-3" />
        </.link>
      </:col>
      <:col :let={p} label="Leader">
        <span class="text-base-content/60 sm:hidden">Leader </span>{p.leader}
      </:col>
      <:col :let={p} label="Replicas">
        <span class="text-base-content/60 sm:hidden">Replicas </span>{Enum.join(p.replicas, ",")}
      </:col>
      <:col :let={p} label="Earliest" numeric>
        <span class="text-base-content/60 sm:hidden">Earliest </span>{p.earliest}
      </:col>
      <:col :let={p} label="Latest" numeric>
        <span class="text-base-content/60 sm:hidden">Latest </span>{p.latest}
      </:col>
    </.table>
  </div>
</Layouts.app>
