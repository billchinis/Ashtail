<.broker_error error={@broker_error} />

<h1>Topics</h1>
<p>{@total} topics</p>

<form id="page-size-form" data-page-size-form phx-change="page_size">
  <label for="page_size">Page size</label>
  <select id="page_size" name="page_size">
    <option value="20" selected={@page_size == 20}>20</option>
    <option value="50" selected={@page_size == 50}>50</option>
  </select>
</form>

<form id="search-form" data-search-form phx-change="search">
  <label for="q">Search</label>
  <input type="text" id="q" name="q" value={@search} phx-debounce="200" />
</form>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Partitions</th>
      <th>Replication</th>
      <th>Messages</th>
    </tr>
  </thead>
  <tbody id="topics" phx-update="stream">
    <tr :for={{dom_id, topic} <- @streams.topics} id={dom_id} data-topic={topic.name}>
      <td>{topic.name}</td>
      <td>{topic.partition_count} partitions</td>
      <td>RF {topic.replication_factor}</td>
      <td>{topic.message_count} messages</td>
    </tr>
  </tbody>
</table>

<div>
  <.link
    :if={@page > 1}
    data-prev-page
    patch={page_path(@page - 1, @page_size, @search)}
  >
    Previous page
  </.link>
  <span>Page {@page} of {@page_count}</span>
  <.link
    :if={@page < @page_count}
    data-next-page
    patch={page_path(@page + 1, @page_size, @search)}
  >
    Next page
  </.link>
</div>
