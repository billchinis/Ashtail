<.broker_error error={@broker_error} />

<h1>Topic {@topic_name}, partition {@partition}</h1>

<form id="page-size-form" data-page-size-form phx-change="page_size">
  <label for="page_size">Page size</label>
  <select id="page_size" name="page_size">
    <option value="20" selected={@page_size == 20}>20</option>
    <option value="50" selected={@page_size == 50}>50</option>
  </select>
</form>

<button type="button" data-tail-toggle phx-click="toggle_tail">
  {if @tailing?, do: "Stop tailing", else: "Start tailing"}
</button>
<span data-tail={if @tailing?, do: "live", else: "off"}></span>

<table>
  <thead>
    <tr>
      <th>Offset</th>
      <th>Key</th>
      <th>Value</th>
      <th>Timestamp</th>
      <th>Headers</th>
    </tr>
  </thead>
  <tbody id="messages" phx-update="stream">
    <tr :for={{dom_id, message} <- @streams.messages} id={dom_id} data-offset={message.offset}>
      <td>{message.offset}</td>
      <td><.message_key key={message.key} /></td>
      <td data-value>
        <.message_value
          value={message.value}
          expanded?={message.expanded?}
          offset={message.offset}
        />
      </td>
      <td>{message.timestamp}</td>
      <td><.message_headers headers={message.headers} /></td>
    </tr>
  </tbody>
</table>

<div>
  <.link
    :if={@earliest != nil and @offset > @earliest}
    data-prev-page
    patch={
      message_path(
        @topic_name,
        @partition,
        max(@earliest, @offset - @page_size),
        @page_size
      )
    }
  >
    Previous page
  </.link>
  <.link
    :if={@latest != nil and @offset + @page_size < @latest}
    data-next-page
    patch={message_path(@topic_name, @partition, @offset + @page_size, @page_size)}
  >
    Next page
  </.link>
</div>
